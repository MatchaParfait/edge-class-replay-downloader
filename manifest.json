{
  "manifest_version": 3,
  "name": "CUMT课堂回放批量下载",
  "version": "2.2.2",
  "description": "用于中国矿业大学云课堂，支持课件与教师视角选择，批量下载当前账户有权访问的课堂回放。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "downloads", "storage", "scripting", "alarms"],
  "host_permissions": ["http://class.cumt.edu.cn/*", "https://class.cumt.edu.cn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "展开或收起CUMT课堂回放批量下载"
  },
  "content_scripts": [{
    "matches": ["http://class.cumt.edu.cn/*", "https://class.cumt.edu.cn/*"],
    "js": ["vendor/lucide.min.js", "floating-panel.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["popup.html"],
    "matches": ["http://class.cumt.edu.cn/*", "https://class.cumt.edu.cn/*"]
  }]
}
