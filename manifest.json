{
  "manifest_version": 3,
  "name": "Class Replay Downloader",
  "version": "2.2.1",
  "description": "Download authorized replays by teacher or courseware view using actual recording files.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "downloads", "storage", "scripting", "alarms"],
  "host_permissions": ["http://class.cumt.edu.cn/*", "https://class.cumt.edu.cn/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "展开或收起课堂回放下载"
  },
  "content_scripts": [{
    "matches": ["http://class.cumt.edu.cn/*", "https://class.cumt.edu.cn/*"],
    "js": ["vendor/lucide.min.js", "floating-panel.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["popup.html"],
    "matches": ["http://class.cumt.edu.cn/*", "https://class.cumt.edu.cn/*"]
  }]
}
